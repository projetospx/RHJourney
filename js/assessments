// ============================================================
// SHOPEE JOURNEY
// MÓDULO DE AVALIAÇÕES
//
// Responsabilidades:
//
// - Colaborador:
//   * vê os próprios checkpoints
//   * escolhe/altera liderança
//   * responde avaliação
//   * salva rascunho
//   * envia avaliação
//
// - Líder:
//   * vê avaliações da própria equipe
//   * responde avaliações de liderança
//
// - ADMIN_RH:
//   * visão consolidada
//   * visualiza respostas
//
// - HR_MANAGER:
//   * visão consolidada somente leitura
//
// ============================================================


let assessmentEmployments = [];

let assessmentSubmissions = [];

let assessmentQuestions = [];

let assessmentCurrentFilter = {
  checkpoint: '',
  status: '',
  search: '',
  regional: '',
  operation: ''
};


// ============================================================
// INICIALIZAÇÃO DO MÓDULO
// ============================================================

(function initializeAssessmentModule() {

  injectAssessmentStyles();


  const originalOpenPage =
    openPage;


  openPage =
    async function patchedOpenPage(
      page
    ) {

      if (
        page ===
        'assessments'
      ) {

        setActiveMenu(
          'assessments'
        );


        pageTitle.textContent =
          currentProfile.role ===
          'EMPLOYEE'
            ? 'Minhas Avaliações'
            : 'Avaliações';


        pageSubtitle.textContent =
          getAssessmentPageSubtitle();


        await loadAssessmentsPage();


        if (
          window.innerWidth <=
          900
        ) {

          sidebar.classList
            .remove('open');

        }


        return;

      }


      return originalOpenPage(
        page
      );

    };

})();


// ============================================================
// SUBTÍTULO
// ============================================================

function getAssessmentPageSubtitle() {

  switch (
    currentProfile.role
  ) {

    case 'ADMIN_RH':

      return 'Acompanhe as avaliações dos colaboradores e das lideranças.';


    case 'HR_MANAGER':

      return 'Visão gerencial das avaliações das Jornadas.';


    case 'LEADER':

      return 'Avalie os colaboradores sob sua responsabilidade.';


    case 'EMPLOYEE':

      return 'Responda seus checkpoints ao longo da Jornada.';


    default:

      return 'Avaliações do Shopee Journey.';

  }

}


// ============================================================
// ENTRADA
// ============================================================

async function loadAssessmentsPage() {

  showPageLoading();


  try {

    assessmentCurrentFilter = {
      checkpoint: '',
      status: '',
      search: '',
      regional: '',
      operation: ''
    };


    if (
      currentProfile.role ===
      'EMPLOYEE'
    ) {

      await loadEmployeeAssessments();

      return;

    }


    if (
      currentProfile.role ===
      'LEADER'
    ) {

      await loadLeaderAssessments();

      return;

    }


    await loadManagementAssessments();

  }

  catch (error) {

    console.error(
      'Erro no módulo Avaliações:',
      error
    );


    pageContent.innerHTML = `

      <div class="system-error">

        <h2>
          Não foi possível carregar as avaliações
        </h2>

        <p>
          ${escapeHTML(
            error.message
          )}
        </p>

      </div>

    `;

  }

}


