// ============================================================
// DATAS
// ============================================================

function formatAssessmentDate(
  value
) {

  if (!value) {
    return '-';
  }


  const date =
    new Date(value);


  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return '-';
  }


  return date
    .toLocaleDateString(
      'pt-BR'
    );

}


function formatAssessmentDateTime(
  value
) {

  if (!value) {
    return '-';
  }


  const date =
    new Date(value);


  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return '-';
  }


  return date
    .toLocaleString(
      'pt-BR',
      {

        day:
          '2-digit',

        month:
          '2-digit',

        year:
          'numeric',

        hour:
          '2-digit',

        minute:
          '2-digit'

      }
    );

}


