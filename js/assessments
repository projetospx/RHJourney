function buildManagementAssessmentItems() {

  const items = [];


  assessmentEmployments
    .forEach(
      employment => {

        const journey =
          getAssessmentJourney(
            employment
          );


        if (!journey) {
          return;
        }


        (
          journey.journey_checkpoints
          ||
          []
        )
          .forEach(
            checkpoint => {

              const employeeSubmission =
                assessmentSubmissions
                  .find(
                    submission =>

                      submission
                        .checkpoint_id ===
                        checkpoint.id

                      &&

                      submission
                        .respondent_type ===
                        'EMPLOYEE'

                  );


              const leaderSubmission =
                assessmentSubmissions
                  .find(
                    submission =>

                      submission
                        .checkpoint_id ===
                        checkpoint.id

                      &&

                      submission
                        .respondent_type ===
                        'LEADER'

                  );


              const employeeStatus =
                getAssessmentSideStatus(

                  checkpoint,

                  employeeSubmission,

                  true

                );


              let leaderStatus;


              if (
                !employment.leader_id
                &&
                !leaderSubmission
              ) {

                leaderStatus =
                  'NO_LEADER';

              }

              else {

                leaderStatus =
                  getAssessmentSideStatus(

                    checkpoint,

                    leaderSubmission,

                    false

                  );

              }


              items.push({

                employment,

                checkpoint,

                employeeSubmission,

                leaderSubmission,

                employeeStatus,

                leaderStatus

              });

            }
          );

      }
    );


  return items;

}


