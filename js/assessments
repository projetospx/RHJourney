async function openAssessmentForm(
  submissionId
) {

  try {

    const {
      data: submission,
      error
    } =
      await journeySupabase
        .from(
          'journey_assessment_submissions'
        )
        .select(`
          id,
          checkpoint_id,
          employment_id,
          respondent_type,
          status,
          started_at,
          submitted_at,

          journey_checkpoints (
            id,
            checkpoint,
            opens_at,
            due_at
          ),

          employments (
            id,

            people (
              full_name
            )
          )
        `)
        .eq(
          'id',
          submissionId
        )
        .single();


    if (error) {
      throw error;
    }


    const checkpointCode =
      submission
        .journey_checkpoints
        ?.checkpoint;


    const {
      data: questions,
      error: questionError
    } =
      await journeySupabase
        .from(
          'journey_assessment_questions'
        )
        .select(`
          id,
          checkpoint,
          respondent_type,
          dimension,
          question_text,
          question_type,
          required,
          display_order,
          options
        `)
        .eq(
          'checkpoint',
          checkpointCode
        )
        .eq(
          'respondent_type',
          submission.respondent_type
        )
        .eq(
          'active',
          true
        )
        .order(
          'display_order'
        );


    if (questionError) {
      throw questionError;
    }


    const {
      data: answers,
      error: answersError
    } =
      await journeySupabase
        .from(
          'journey_assessment_answers'
        )
        .select(`
          id,
          question_id,
          numeric_value,
          text_value,
          boolean_value,
          option_value
        `)
        .eq(
          'submission_id',
          submissionId
        );


    if (answersError) {
      throw answersError;
    }


    if (
      !questions?.length
    ) {

      alert(
        `Ainda não existem perguntas cadastradas para ${checkpointCode} neste perfil.`
      );

      return;

    }


    renderAssessmentFormModal(
      submission,
      questions,
      answers || []
    );

  }

  catch (error) {

    console.error(error);


