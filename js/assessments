  }


  if (
    availability ===
    'OVERDUE'
  ) {

    return `

      <div class="assessment-checkpoint-card attention">

        <div class="assessment-checkpoint-code">
          ${escapeHTML(
            checkpoint.checkpoint
          )}
        </div>


        <div class="assessment-checkpoint-info">

          <strong>
            Avaliação pendente
          </strong>

          <span>
            Prazo original:
            ${formatAssessmentDate(
              checkpoint.due_at
