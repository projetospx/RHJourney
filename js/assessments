async function loadLeaderAssessments() {

  const {
    data: employments,
    error
  } =
    await journeySupabase
      .from('employments')
      .select(`
        id,
        leader_id,
        admission_date,
        status,

        people (
          id,
          full_name,
          cpf
        ),

        operations (
          id,
          name,

          regionals (
            id,
            name
          )
        ),

        journeys (
          id,
          status,

          journey_checkpoints (
            id,
            checkpoint,
            opens_at,
            due_at
          )
        )
      `)
      .eq(
        'leader_id',
        currentProfile.id
      )
      .order(
        'admission_date',
        {
          ascending: false
        }
      );


  if (error) {
    throw error;
  }


  assessmentEmployments =
    employments ||
    [];


  const checkpointIds =
    collectCheckpointIds(
      assessmentEmployments
    );


  let submissions = [];


  if (
    checkpointIds.length
  ) {

    const {
      data,
      error: submissionsError
    } =
      await journeySupabase
        .from(
          'journey_assessment_submissions'
        )
        .select(`
          id,
          checkpoint_id,
          employment_id,
          respondent_type,
          respondent_user_id,
          leader_snapshot_id,
          status,
          started_at,
          submitted_at
        `)
        .in(
          'checkpoint_id',
          checkpointIds
        )
        .eq(
          'respondent_type',
          'LEADER'
        );


    if (submissionsError) {
      throw submissionsError;
    }


    submissions =
      data || [];

  }


  assessmentSubmissions =
    submissions;


  renderLeaderAssessmentPage();

}


