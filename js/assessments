      border-radius:18px;
      background:
        linear-gradient(
          135deg,
          rgba(238,77,45,.13),
          rgba(238,77,45,.03)
        );
      border:1px solid
        rgba(238,77,45,.12);
    }


    .assessment-welcome h2,
    .assessment-module-header h2 {
      margin:4px 0 8px;
    }


    .assessment-welcome p,
    .assessment-module-header p {
      margin:0;
      opacity:.74;
      max-width:680px;
    }


    .assessment-eyebrow {
      font-size:11px;
      font-weight:800;
      letter-spacing:.11em;
      color:#EE4D2D;
    }


    .assessment-progress-number {
      min-width:90px;
      height:90px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:50%;
      font-size:22px;
      font-weight:800;
      border:8px solid
        rgba(238,77,45,.18);
      color:#EE4D2D;
    }


    .assessment-metrics {
      display:grid;
      grid-template-columns:
        repeat(3, minmax(0,1fr));
      gap:14px;
      margin-bottom:20px;
    }


    .assessment-metric {
      padding:18px 20px;
      border-radius:15px;
      border:1px solid
        var(--border-color, rgba(0,0,0,.08));
      background:
        var(--card-bg, #fff);
    }


    .assessment-metric span {
      display:block;
      font-size:12px;
      opacity:.7;
      margin-bottom:8px;
    }


    .assessment-metric strong {
      font-size:28px;
    }


    .assessment-metric.attention strong {
      color:#d14343;
    }


    .assessment-leader-card {
      display:flex;
      align-items:center;
      gap:16px;
      padding:18px 20px;
      border-radius:16px;
      border:1px solid
        rgba(238,77,45,.16);
      background:
        var(--card-bg, #fff);
      margin-bottom:20px;
    }


    .assessment-leader-card.warning {
      border-style:dashed;
    }


    .assessment-leader-avatar {
      width:48px;
      height:48px;
      min-width:48px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:800;
      background:
        rgba(238,77,45,.12);
      color:#EE4D2D;
    }


    .assessment-leader-avatar.small {
      width:38px;
      height:38px;
      min-width:38px;
      font-size:12px;
    }


    .assessment-leader-info {
      flex:1;
      min-width:0;
    }


    .assessment-leader-info span,
    .assessment-leader-info small {
      display:block;
      opacity:.68;
    }


    .assessment-leader-info strong {
      display:block;
      margin:3px 0;
    }


    .assessment-leader-actions {
      display:flex;
      align-items:center;
      gap:8px;
      flex-wrap:wrap;
    }


    .assessment-outline-button,
    .assessment-link-button,
    .assessment-status-button {
      border:1px solid
        rgba(238,77,45,.25);
      background:transparent;
      color:#EE4D2D;
      border-radius:9px;
      padding:9px 12px;
      cursor:pointer;
      font-weight:700;
    }


    .assessment-link-button {
      border:0;
    }


    .assessment-status-button.success {
      color:#17884a;
      border-color:
        rgba(23,136,74,.25);
    }


    .assessment-timeline {
      display:flex;
      flex-direction:column;
      gap:10px;
    }


    .assessment-checkpoint-card {
      display:grid;
      grid-template-columns:
        62px minmax(0,1fr) auto auto;
      align-items:center;
      gap:14px;
      padding:16px;
      border-radius:14px;
      border:1px solid
        var(--border-color, rgba(0,0,0,.08));
    }


    .assessment-checkpoint-card.available {
      border-color:
        rgba(238,77,45,.30);
    }


    .assessment-checkpoint-card.attention {
      border-color:
        rgba(209,67,67,.28);
    }


    .assessment-checkpoint-code {
      width:52px;
      height:52px;
      border-radius:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:800;
      background:
        rgba(238,77,45,.10);
      color:#EE4D2D;
    }


    .assessment-checkpoint-info strong,
    .assessment-checkpoint-info span {
      display:block;
    }


    .assessment-checkpoint-info span {
      margin-top:4px;
      font-size:12px;
      opacity:.68;
    }


    .assessment-status {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:6px 9px;
      border-radius:999px;
      font-size:10px;
      font-weight:800;
      white-space:nowrap;
    }


    .assessment-status.success {
      background:
        rgba(23,136,74,.10);
      color:#17884a;
    }


    .assessment-status.warning {
      background:
        rgba(238,77,45,.10);
      color:#EE4D2D;
    }


    .assessment-status.danger {
      background:
        rgba(209,67,67,.10);
      color:#d14343;
    }


    .assessment-status.muted {
      background:
        rgba(127,127,127,.10);
      opacity:.68;
    }


    .assessment-tab-group {
      display:flex;
      gap:6px;
      padding:5px;
      border-radius:12px;
      background:
        rgba(127,127,127,.08);
    }


    .assessment-tab {
      border:0;
      background:transparent;
      padding:10px 16px;
      border-radius:8px;
      cursor:pointer;
      font-weight:700;
    }


    .assessment-tab.active {
      background:#EE4D2D;
      color:#fff;
    }


    .assessment-modal-body,
    .assessment-viewer {
      padding:22px;
    }


    .assessment-leader-selection {
      display:flex;
      flex-direction:column;
      gap:8px;
    }


    .assessment-leader-option {
      display:flex;
      align-items:center;
      gap:12px;
      width:100%;
      padding:13px;
      text-align:left;
      cursor:pointer;
      border-radius:12px;
      border:1px solid
        var(--border-color, rgba(0,0,0,.08));
      background:
        var(--card-bg, #fff);
    }


    .assessment-leader-option > span:nth-child(2) {
      flex:1;
    }


    .assessment-leader-option strong,
    .assessment-leader-option small {
      display:block;
    }


    .assessment-leader-option small {
      opacity:.65;
      margin-top:3px;
    }


    .assessment-leader-option b {
      font-size:11px;
      color:#EE4D2D;
    }


    .assessment-form-modal {
      max-height:88vh;
      overflow:auto;
    }


    .assessment-form {
      padding:22px;
    }


    .assessment-question {
      padding:20px 0;
      border-bottom:1px solid
        var(--border-color, rgba(0,0,0,.08));
    }


    .assessment-question:first-child {
      padding-top:0;
    }


    .assessment-question-heading {
      display:flex;
      align-items:flex-start;
      gap:12px;
      margin-bottom:16px;
    }


    .assessment-question-heading > span {
      width:30px;
      height:30px;
      min-width:30px;
      border-radius:8px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:
        rgba(238,77,45,.10);
      color:#EE4D2D;
      font-weight:800;
    }


    .assessment-question-heading small,
    .assessment-question-heading strong,
    .assessment-question-heading em {
      display:block;
    }


    .assessment-question-heading small {
      color:#EE4D2D;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.05em;
    }


    .assessment-question-heading strong {
      margin:4px 0;
      font-size:14px;
      line-height:1.45;
    }


    .assessment-question-heading em {
      opacity:.55;
      font-size:10px;
      font-style:normal;
    }


    .assessment-scale {
      display:grid;
      grid-template-columns:
        repeat(5,1fr);
      gap:8px;
    }


    .assessment-scale-option input,
    .assessment-choice-buttons input,
    .assessment-single-choice input {
      position:absolute;
      opacity:0;
      pointer-events:none;
    }


    .assessment-scale-option span {
      height:46px;
      display:flex;
      align-items:center;
      justify-content:center;
      border:1px solid
        var(--border-color, rgba(0,0,0,.10));
      border-radius:10px;
      cursor:pointer;
      font-weight:800;
    }


    .assessment-scale-option input:checked + span {
      background:#EE4D2D;
      border-color:#EE4D2D;
      color:#fff;
    }


    .assessment-scale-labels {
      display:flex;
      justify-content:space-between;
      margin-top:7px;
      font-size:10px;
      opacity:.60;
    }


    .assessment-choice-buttons {
      display:flex;
      gap:10px;
    }


    .assessment-choice-buttons span,
    .assessment-single-choice span {
      display:block;
      padding:10px 16px;
      border-radius:9px;
      border:1px solid
        var(--border-color, rgba(0,0,0,.10));
      cursor:pointer;
    }


    .assessment-choice-buttons input:checked + span,
    .assessment-single-choice input:checked + span {
      background:#EE4D2D;
      color:#fff;
      border-color:#EE4D2D;
    }


    .assessment-single-choice {
      display:flex;
      flex-direction:column;
      gap:7px;
    }


    .assessment-textarea {
      width:100%;
      box-sizing:border-box;
      resize:vertical;
      border-radius:10px;
      padding:12px;
      background:
        var(--input-bg, transparent);
      color:inherit;
      border:1px solid
        var(--border-color, rgba(0,0,0,.12));
      font:inherit;
    }


    .assessment-form-footer {
      display:flex;
      justify-content:flex-end;
      gap:10px;
      padding-top:22px;
    }


    .assessment-view-answer {
      padding:16px 0;
      border-bottom:1px solid
        var(--border-color, rgba(0,0,0,.08));
    }


    .assessment-view-answer span {
      display:block;
      color:#EE4D2D;
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
    }


    .assessment-view-answer strong {
      display:block;
      margin:5px 0 9px;
      font-size:13px;
    }


    .assessment-view-answer p {
      margin:0;
      font-size:14px;
      line-height:1.5;
    }


    .assessment-empty-large {
      min-height:320px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:30px;
    }


    .assessment-empty-icon {
      width:62px;
      height:62px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:50%;
      margin-bottom:14px;
      color:#EE4D2D;
      background:
        rgba(238,77,45,.10);
      font-size:24px;
    }


    @media (
      max-width: 800px
    ) {

      .assessment-metrics {
        grid-template-columns:1fr;
      }


      .assessment-welcome,
      .assessment-module-header,
      .assessment-leader-card {
        align-items:flex-start;
        flex-direction:column;
      }


      .assessment-checkpoint-card {
        grid-template-columns:
          52px minmax(0,1fr);
      }


      .assessment-checkpoint-card
      > .assessment-status,
      .assessment-checkpoint-card
      > button {
        grid-column:2;
        justify-self:start;
      }


      .assessment-progress-number {
        display:none;
      }

    }

  `;


  document.head
    .appendChild(
      style
    );

}
