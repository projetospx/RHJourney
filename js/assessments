function buildLeaderAssessmentItems() {

  const items = [];


  assessmentEmployments
    .forEach(
      employment => {

        const journey =
          getAssessmentJourney(
            employment
          );


        if (!journey) {
          return;
        }


        (
          journey.journey_checkpoints
          ||
          []
        )
          .forEach(
            checkpoint => {

              const submission =
                assessmentSubmissions
                  .find(
                    item =>
                      item.checkpoint_id ===
                      checkpoint.id
                  );


              let status;


              if (
                submission?.status ===
                'SUBMITTED'
              ) {

                status =
                  'SUBMITTED';

              }

              else if (
                submission?.status ===
                'DRAFT'
              ) {

                status =
                  'DRAFT';

              }

              else {

                status =
                  getCheckpointAvailability(
                    checkpoint
                  );

              }


              items.push({

                employment,
                checkpoint,
                submission,
                status

              });

            }
          );

      }
    );


  return items;

}


