async function loadManagementAssessments() {

  const {
    data: employments,
    error
  } =
    await journeySupabase
      .from('employments')
      .select(`
        id,
        leader_id,
        operation_id,
        admission_date,
        status,

        people (
          id,
          full_name,
          cpf
        ),

        bpos (
          id,
          name
        ),

        operations (
          id,
          name,
          regional_id,

          regionals (
            id,
            name
          )
        ),

        leader:profiles!employments_leader_id_fkey (
          id,
          full_name
        ),

        journeys (
          id,
          status,

          journey_checkpoints (
            id,
            checkpoint,
            opens_at,
            due_at
          )
        )
      `)
      .order(
        'admission_date',
        {
          ascending: false
        }
      );


  if (error) {
    throw error;
  }


  assessmentEmployments =
    employments ||
    [];


  const checkpointIds =
    collectCheckpointIds(
      assessmentEmployments
    );


  let submissions = [];


  if (
    checkpointIds.length
  ) {

    const {
      data,
      error: submissionsError
    } =
      await journeySupabase
        .from(
          'journey_assessment_submissions'
        )
        .select(`
          id,
          checkpoint_id,
          employment_id,
          respondent_type,
          respondent_user_id,
          leader_snapshot_id,
          status,
          started_at,
          submitted_at,

          respondent:profiles!journey_assessment_submissions_respondent_user_id_fkey (
            id,
            full_name
          ),

          leader_snapshot:profiles!journey_assessment_submissions_leader_snapshot_id_fkey (
            id,
            full_name
          )
        `)
        .in(
          'checkpoint_id',
          checkpointIds
        );


    if (submissionsError) {
      throw submissionsError;
    }


    submissions =
      data || [];

  }


  assessmentSubmissions =
    submissions;


  renderManagementAssessmentPage();

}


