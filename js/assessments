// ============================================================

function collectCheckpointIds(
  employments
) {

  const ids = [];


  employments.forEach(
    employment => {

      const journey =
        getAssessmentJourney(
          employment
        );


      if (!journey) {
        return;
      }


      (
        journey.journey_checkpoints
        ||
        []
      )
        .forEach(
          checkpoint => {

            ids.push(
              checkpoint.id
            );

          }
        );

    }
  );


  return [
    ...new Set(ids)
  ];

}


