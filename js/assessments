// ============================================================
// SALVAR FORMULÁRIO
// ============================================================

async function saveAssessmentForm(
  submissionId,
  questions,
  submitAfterSave
) {

  const saveButton =
    document
      .getElementById(
        'saveAssessmentDraftButton'
      );


  const submitButton =
    document
      .getElementById(
        'submitAssessmentButton'
      );


  try {

    if (saveButton) {
      saveButton.disabled = true;
    }


    if (submitButton) {
      submitButton.disabled = true;
    }


    const responses =
      collectAssessmentResponses(
        questions
      );


    if (
      submitAfterSave
    ) {

      const missing =
        responses.filter(
          response =>
            response.required
            &&
            !response.hasValue
        );


      if (
        missing.length
      ) {

        throw new Error(
          `Existem ${missing.length} pergunta(s) obrigatória(s) sem resposta.`
        );

      }

    }


    for (
      const response
      of responses
    ) {

      if (
        !response.hasValue
      ) {
        continue;
      }


      const {
        error
      } =
        await journeySupabase
          .rpc(
            'save_journey_assessment_answer',
            {

              p_submission_id:
                submissionId,

              p_question_id:
                response.questionId,

              p_numeric_value:
                response.numericValue,

              p_text_value:
                response.textValue,

              p_boolean_value:
                response.booleanValue,

              p_option_value:
                response.optionValue

            }
          );


      if (error) {
        throw error;
      }

    }


    if (
      submitAfterSave
    ) {

      const confirmed =
        confirm(
          'Enviar esta avaliação?\n\nDepois do envio ela será considerada concluída.'
        );


      if (!confirmed) {

        if (saveButton) {
          saveButton.disabled = false;
        }


        if (submitButton) {
          submitButton.disabled = false;
        }


        return;

      }


      const {
        error
      } =
        await journeySupabase
          .rpc(
            'submit_journey_assessment',
            {
              p_submission_id:
                submissionId
            }
          );


      if (error) {
        throw error;
      }


      closeGenericModal();


      alert(
        'Avaliação enviada com sucesso. 🧡'
      );


      await loadAssessmentsPage();

      return;

    }


    alert(
      'Rascunho salvo.'
    );

  }

  catch (error) {

    console.error(error);


    alert(
      error.message
      ||
      'Não foi possível salvar a avaliação.'
    );

  }

  finally {

    if (saveButton) {
      saveButton.disabled = false;
    }


    if (submitButton) {
      submitButton.disabled = false;
    }

  }

}


// ============================================================
// COLETAR RESPOSTAS
// ============================================================

function collectAssessmentResponses(
  questions
) {

  return questions.map(
    question => {

      const container =
        document.querySelector(
          `[data-question-id="${question.id}"]`
        );


      let numericValue =
        null;


      let textValue =
        null;


      let booleanValue =
        null;


      let optionValue =
        null;


      let hasValue =
        false;


      switch (
        question.question_type
      ) {


        case 'SCALE_1_5': {

          const selected =
            container
              ?.querySelector(
                `input[name="assessment_${question.id}"]:checked`
              );


          if (selected) {

            numericValue =
              Number(
                selected.value
              );


            hasValue =
              true;

          }


          break;

        }


        case 'YES_NO': {

          const selected =
            container
              ?.querySelector(
                `input[name="assessment_${question.id}"]:checked`
              );


          if (selected) {

            booleanValue =
              selected.value ===
              'true';


            hasValue =
              true;

          }


          break;

        }


        case 'TEXT': {

          const textarea =
            container
              ?.querySelector(
                '[data-answer-field="text"]'
              );


          const value =
            textarea
              ?.value
              ?.trim()
            ||
            '';


          if (value) {

            textValue =
              value;


            hasValue =
              true;

          }


          break;

        }


        case 'SINGLE_CHOICE': {

          const selected =
            container
              ?.querySelector(
                `input[name="assessment_${question.id}"]:checked`
              );


          if (selected) {

            optionValue =
              selected.value;


            hasValue =
              true;

          }


          break;

        }

      }


      return {

        questionId:
          question.id,

        required:
          question.required,

        numericValue,

        textValue,

        booleanValue,

        optionValue,

        hasValue

      };

    }
  );

}


