function renderEmployeeAssessments(
  employment,
  journey,
  submissions
) {

  const checkpoints =
    (
      journey.journey_checkpoints
      ||
      []
    )
      .slice()
      .sort(
        sortCheckpoints
      );


  const availableCount =
    checkpoints.filter(
      checkpoint => {

        const status =
          getCheckpointAvailability(
            checkpoint
          );


        const submission =
          submissions.find(
            item =>
              item.checkpoint_id ===
              checkpoint.id
          );


        return (
          status === 'AVAILABLE'
          &&
          submission?.status !==
          'SUBMITTED'
        );

      }
    )
      .length;


  const submittedCount =
    submissions.filter(
      submission =>
        submission.status ===
        'SUBMITTED'
    )
      .length;


  pageContent.innerHTML = `

    <div class="assessment-welcome">

      <div>

        <span class="assessment-eyebrow">
          MINHA JORNADA
        </span>

        <h2>
          Suas avaliações 🧡
        </h2>

        <p>
          Suas respostas ajudam a acompanhar
          como está sendo sua experiência
          durante os primeiros 90 dias.
        </p>

      </div>

      <div class="assessment-progress-number">
        ${submittedCount}/${checkpoints.length}
      </div>

    </div>


    ${renderEmployeeLeaderCard(
      employment
    )}


    <div class="assessment-metrics">

      <div class="assessment-metric">

        <span>
          Disponíveis
        </span>

        <strong>
          ${availableCount}
        </strong>

      </div>


      <div class="assessment-metric">

        <span>
          Respondidas
        </span>

        <strong>
          ${submittedCount}
        </strong>

      </div>


      <div class="assessment-metric">

        <span>
          Total de etapas
        </span>

        <strong>
          ${checkpoints.length}
        </strong>

      </div>

    </div>


    <section class="dashboard-panel">

      <div class="panel-header">

        <div>

          <h3>
            Linha do tempo
          </h3>

          <p>
            Cada etapa será liberada
            conforme sua Jornada avança.
          </p>

        </div>

      </div>


      <div class="assessment-timeline">

        ${
          checkpoints
            .map(
              checkpoint => {

                const submission =
                  submissions.find(
                    item =>
                      item.checkpoint_id ===
                      checkpoint.id
                  );


                return renderEmployeeCheckpointCard(
                  checkpoint,
                  submission
                );

              }
            )
            .join('')
        }

      </div>

    </section>

  `;


  bindEmployeeLeaderCard(
    employment
  );


  document
    .querySelectorAll(
      '.employee-open-assessment'
    )
    .forEach(
      button => {

        button.addEventListener(
          'click',
          () => {

            openEmployeeAssessment(
              button.dataset.checkpointId
            );

          }
        );

      }
    );


  document
    .querySelectorAll(
      '.employee-view-assessment'
    )
    .forEach(
      button => {

        button.addEventListener(
          'click',
          () => {

            openSubmittedAssessmentViewer(
              button.dataset.submissionId
            );

          }
        );

      }
    );

}


