async function openEmployeeLeaderSelector(
  employment
) {

  try {

    const {
      data,
      error
    } =
      await journeySupabase
        .rpc(
          'get_eligible_leaders_for_employment',
          {
            p_employment_id:
              employment.id
          }
        );


    if (error) {
      throw error;
    }


    const leaders =
      data || [];


    if (!leaders.length) {

      alert(
        'Nenhuma liderança elegível foi encontrada para sua operação.'
      );

      return;

    }


    openGenericModal(`

      <div class="modal-header">

        <div>

          <h2>
            Quem é seu líder?
          </h2>

          <p>
            Selecione sua liderança atual.
          </p>

        </div>


        <button
          id="closeGenericModalButton"
          class="modal-close"
          type="button"
        >
          ×
        </button>

      </div>


      <div class="assessment-modal-body">

        <div class="assessment-leader-selection">

          ${
            leaders
              .map(
                leader => `

                  <button
                    class="assessment-leader-option"
                    type="button"
                    data-leader-id="${leader.leader_id}"
                    data-leader-name="${escapeHTML(
                      leader.full_name
                    )}"
                  >

                    <span class="assessment-leader-avatar small">
                      ${getInitials(
                        leader.full_name
                      )}
                    </span>


                    <span>

                      <strong>
                        ${escapeHTML(
                          leader.full_name
                        )}
                      </strong>

                      <small>
                        ${
                          leader.period_name

                            ? escapeHTML(
                                leader.period_name
                              )

                            : escapeHTML(
                                employment
                                  .operations
                                  ?.name
                                ||
                                ''
                              )
                        }
                      </small>

                    </span>


                    ${
                      employment.leader_id ===
                      leader.leader_id

                        ? `

                          <b>
                            Atual
                          </b>

                        `

                        : `
                          <b>Selecionar →</b>
                        `
                    }

                  </button>

                `
              )
              .join('')
          }

        </div>

      </div>

    `);


    document
      .querySelectorAll(
        '.assessment-leader-option'
      )
      .forEach(
        button => {

          button.addEventListener(
            'click',
            () => {

              employeeSelectLeader(
                employment,
                button.dataset.leaderId,
                button.dataset.leaderName
              );

            }
          );

        }
      );

  }

  catch (error) {

    console.error(error);


    alert(
      error.message
      ||
      'Não foi possível carregar as lideranças.'
    );

  }

}


// ============================================================
// COLABORADOR DEFINE LÍDER
// ============================================================

async function employeeSelectLeader(
  employment,
  leaderId,
  leaderName
) {

  if (
    employment.leader_id ===
    leaderId
  ) {

    closeGenericModal();

    return;

  }


  const message =
    employment.leader_id

      ? `Confirmar alteração da sua liderança para ${leaderName}?`

      : `Confirmar ${leaderName} como seu líder atual?`;


  if (
    !confirm(message)
  ) {
    return;
  }


  try {

    const {
      error
    } =
      await journeySupabase
        .rpc(
          'set_employment_leader',
          {

            p_employment_id:
              employment.id,

            p_new_leader_id:
              leaderId,

            p_source:
              'EMPLOYEE_SELECTED',

            p_reason:
              employment.leader_id
                ? 'Liderança atualizada pelo colaborador.'
                : 'Liderança informada pelo colaborador.'

          }
        );


    if (error) {
      throw error;
    }


    closeGenericModal();


    await loadEmployeeAssessments();

  }

  catch (error) {

    console.error(error);


    alert(
      error.message
      ||
      'Não foi possível atualizar sua liderança.'
    );

  }

}


